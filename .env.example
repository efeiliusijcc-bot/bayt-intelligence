# 生产环境必须修改以下三项。不要把真实值提交到代码库。
APP_USER=change-me
APP_PASSWORD=change-me-with-a-long-random-password
PREVIEW_SECRET=replace-with-at-least-32-random-characters
COLLECTOR_ENABLED=1
COLLECTOR_API_URL=http://bayt-collector-worker:4191
COLLECTOR_API_TOKEN=replace-with-at-least-32-random-characters

# 人物研究为可选能力。未配置时仍可运行确定性评分，但不会产生模拟搜索结果。
TAVILY_API_KEY=
TAVILY_ENDPOINT=https://api.tavily.com/search
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=
RESEARCH_AUTO_RUN=0

# 默认只监听服务器本机，建议通过SSH隧道或HTTPS反向代理访问。
BAYT_BIND_ADDRESS=127.0.0.1
BAYT_PORT=4180

# 空平台可保留默认目录。挂载真实候选人数据前应另行确认授权范围。
BAYT_DATA_DIR=./deployment-data/published
