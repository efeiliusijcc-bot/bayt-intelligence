{
  "name": "bayt-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch --experimental-strip-types server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --experimental-strip-types server/index.ts",
    "test": "vitest run",
    "test:server": "node --experimental-strip-types --test server/**/*.test.ts",
    "check": "npm run test && npm run test:server && npm run build"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@fluentui/react-charts": "9.3.24",
    "@fluentui/react-components": "^9.72.7",
    "@fluentui/react-icons": "^2.0.319",
    "@tanstack/react-query": "^5.87.1",
    "express": "^5.1.0",
    "mime-types": "^3.0.1",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "yauzl": "^3.2.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.3",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
